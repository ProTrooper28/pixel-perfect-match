# ─────────────────────────────────────────────
#  doc-ingestion — environment variables
#  Copy to .env and fill in real values.
# ─────────────────────────────────────────────

# ── Service ──────────────────────────────────
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO
ENV=development            # development | production

# ── File constraints ─────────────────────────
MAX_FILE_SIZE_MB=50        # hard ceiling for uploads
ALLOWED_EXTENSIONS=pdf,ppt,pptx

# ── Supabase ─────────────────────────────────
SUPABASE_URL=https://gzrzxhvjefecwvgbqlzi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # service role key — NEVER expose to browser
SUPABASE_DOCUMENTS_BUCKET=documents

# ── Google Cloud Vision (OCR) ─────────────────
# Set this to the path of a service-account JSON file OR leave blank to disable OCR.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternatively supply the raw JSON content (useful for container env vars):
GOOGLE_CLOUD_VISION_CREDENTIALS_JSON=

# ── Internal security ─────────────────────────
# Optional shared secret checked in X-Service-Token header.
# Leave empty to disable token auth (dev only).
SERVICE_SECRET_TOKEN=
